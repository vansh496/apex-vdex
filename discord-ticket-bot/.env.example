######################
#  APEX Ticket Bot — environment
#  Ye file ka naam exactly `.env` hona chahiye.
######################

# Discord Developer Portal > Bot > Reset Token
# https://discord.com/developers/applications
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Optional: apna Discord user ID (owner ko logs/commands milte hain)
OWNER_ID=

# Optional: ek user ke max open tickets (default 3)
MAX_OPEN_TICKETS=3

# Optional: sirf ek server me commands sync karo (fast) — apna server ID
GUILD_ID=

# Optional: INFO / DEBUG
LOG_LEVEL=INFO

# Privileged Intents — portal me bhi ON karne honge
INTENT_MESSAGE_CONTENT=true
INTENT_MEMBERS=false
